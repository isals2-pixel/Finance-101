      "related": ["inflation"],
      "misconceptions": [
        { "statement": "The euro is valuable because it is backed by gold.", "correction": "No major currency is redeemable in gold. Fiat money's value rests on shared acceptance, legal-tender status, and central-bank-managed scarcity." },
        { "statement": "Money and wealth are the same thing.", "correction": "Wealth is everything owned that has value; money is one form of it, and its purchasing power erodes as prices rise." },
        { "statement": "Keeping cash means taking no risk.", "correction": "Cash is certain in nominal terms only; it carries purchasing-power risk when prices rise." }
